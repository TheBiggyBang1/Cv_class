# Copier ce fichier en .env, puis renseigner la clé. Le fichier .env n'est jamais commité.

# Clé API Anthropic (obligatoire) : https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Modèle utilisé pour lire les CV (optionnel)
CV_MODEL=claude-sonnet-5-5

# false : TBS / ENIT / IHEC sont une priorité (classés en tête)
# true  : une école hors liste donne NO GO
ECOLE_ELIMINATOIRE=false
